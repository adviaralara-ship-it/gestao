rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuário autenticado com credenciais reais (não anônimo)
    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Qualquer sessão autenticada (incluindo moradores anônimos em enquetes/links)
    function hasAnyAuth() {
      return request.auth != null;
    }

    // Candidatos a vagas de emprego (público para envio de currículo)
    match /candidatos/{docId} {
      allow create: if true;
      allow read, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Notificações do sistema
    match /notificacoes/{docId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Usuários do sistema (isolamento estrito de credenciais - nenhuma senha pode ser salva no Firestore)
    match /usuarios/{userId} {
      allow create: if !('senha' in request.resource.data);
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && !('senha' in request.resource.data);
      allow delete: if isAuthenticated();
    }

    // Moradores (cadastro público controlado)
    match /moradores/{moradorId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Registros de auditoria (apenas autenticado, imutáveis)
    match /auditoria_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    match /auditoria/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    // Ponto eletrônico (registro com foto/GPS)
    match /ponto_registros/{pontoId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Enquetes: leitura pública, votação permitida para qualquer sessão ativa
    match /enquetes/{enqueteId} {
      allow read: if true;
      allow write: if hasAnyAuth();
    }

    // Mediações: leitura de sala permitida, alteração apenas autenticada
    match /mediacoes/{mediacaoId} {
      allow read: if true;
      allow update: if hasAnyAuth();
      allow create, delete: if isAuthenticated();
    }

    // Visitantes e Convidados de Eventos
    match /visitantes/{visitanteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /eventos_convidados/{convidadoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Módulos confidenciais (Financeiro, Boletos, Documentos, Contratos, etc.)
    // Apenas usuários registrados e autenticados de verdade (bloqueia anônimos)
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
