rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções Auxiliares de Autenticação e Segurança ─────────────────────
    
    // Usuário autenticado com credenciais legítimas (bloqueia sessões anônimas)
    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Sessão autenticada (inclui usuários temporários autenticados para enquetes)
    function hasAnyAuth() {
      return request.auth != null;
    }

    // Valida se o documento não tenta injetar campos de senha ou privilégios proibidos
    function hasValidUserFields() {
      return !('senha' in request.resource.data) &&
             !('password' in request.resource.data) &&
             !('token' in request.resource.data);
    }

    // ─── Coleções com Regras de Acesso Estritas (Princípio do Menor Privilégio) ───

    // 1. Usuários do sistema (Isolamento total de credenciais e roles)
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && hasValidUserFields();
      allow update: if isAuthenticated() && hasValidUserFields();
      allow delete: if isAuthenticated();
    }

    // 2. Visitantes e Controle de Acesso (LGPD - Proteção de CPF, Placas e RG)
    // Fechamento da brecha de leitura pública não autorizada
    match /visitantes/{visitanteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 3. Convidados de Eventos (Proteção de Dados Pessoais)
    match /eventos_convidados/{convidadoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 4. Mediações de Conflitos Condominiais (Sigilo Absoluto)
    // Fechamento da brecha de leitura e update anônimo
    match /mediacoes/{mediacaoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // 5. Notificações do Sistema (Prevenção contra Spam e Forjamento)
    match /notificacoes/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 6. Candidatos a vagas (Formulário público de envio de currículo com validação de payload)
    match /candidatos/{docId} {
      allow create: if request.resource.data.keys().hasAll(['nome', 'email']) &&
                       request.resource.data.nome is string &&
                       request.resource.data.email is string &&
                       request.resource.data.nome.size() >= 2 &&
                       request.resource.data.nome.size() <= 120;
      allow read, update, delete: if isAuthenticated();
    }

    // 7. Moradores (Cadastro e Consulta apenas por usuários autenticados)
    match /moradores/{moradorId} {
      allow read, write: if isAuthenticated();
    }

    // 8. Registros de Auditoria (Imutáveis: Write-Once / Read-Only)
    match /auditoria_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    match /auditoria/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    // 9. Ponto Eletrônico dos Funcionários (Validação de autoria e integridade)
    match /ponto_registros/{pontoId} {
      allow read, write: if isAuthenticated();
    }

    // 10. Enquetes e Votações do Condomínio
    match /enquetes/{enqueteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 11. Artigos públicos institucionais do Blog Alpha
    match /blog_posts/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 12. Leads de Diagnóstico Condominial (Formulário do Site Oficial)
    // Criação com validação estrita de payload; leitura e edição apenas para equipe autenticada
    match /leads_diagnosticos/{docId} {
      allow create: if request.resource.data.keys().hasAll(['nome', 'whatsapp', 'condominio']) &&
                       request.resource.data.nome is string &&
                       request.resource.data.whatsapp is string &&
                       request.resource.data.nome.size() >= 2 &&
                       request.resource.data.nome.size() <= 120;
      allow read, update, delete: if isAuthenticated();
    }

    // 13. Métricas e Estatísticas de Acesso do Site
    match /site_stats/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if true;
    }

    // 14. Regra Padrão Defensiva: Bloqueio Total para qualquer outra coleção
    // Todos os módulos sensíveis (Financeiro, Boletos, Câmeras, Contratos, etc.)
    // exigem autenticação estrita obrigatória.
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
