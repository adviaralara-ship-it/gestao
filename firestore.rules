rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções Auxiliares de Autenticação e Segurança ─────────────────────

    // Usuário autenticado com credenciais legítimas (bloqueia sessões anônimas)
    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Sessão autenticada (inclui usuários temporários anônimos para enquetes e baixas)
    function hasAnyAuth() {
      return request.auth != null;
    }

    // Obtenção segura dos dados de perfil do usuário logado
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Validação de privilégio de Administrador Master
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email in [
          'admin@alpha.com.br', 'master@alpha.com.br', 'iaralara1812@gmail.com', 'adviaralara@gmail.com'
        ]) ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         getUserData().role == 'Administrador')
      );
    }

    // Valida se o documento não tenta injetar campos de senha ou privilégios proibidos
    function hasValidUserFields() {
      return !('senha' in request.resource.data) &&
             !('password' in request.resource.data) &&
             !('token' in request.resource.data);
    }

    // ─── 1. Usuários do Sistema (Prevenção contra Escalação de Privilégios e IDOR) ───
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      // Criação permitida para cadastro próprio ou pelo administrador
      allow create: if isAuthenticated() && hasValidUserFields() && (isAdmin() || request.auth.uid == userId);
      // Usuário comum só pode atualizar seu próprio perfil e NÃO PODE alterar role, permissões ou status ativo
      allow update: if isAuthenticated() && hasValidUserFields() && (
        isAdmin() || (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'permissoes', 'ativo', 'status', 'pendenteAprovacao'
          ])
        )
      );
      // Apenas administradores podem excluir usuários
      allow delete: if isAdmin();
    }

    // ─── 2. Segurança e Cofre de Backups ───
    match /backups_sistema/{docId} {
      allow read, write: if isAdmin();
    }

    match /travas_sistema/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ─── 3. Visitantes e Controle de Acesso (LGPD) ───
    match /visitantes/{visitanteId} {
      allow read, write: if isAuthenticated();
    }

    match /eventos_convidados/{convidadoId} {
      allow read, write: if isAuthenticated();
    }

    // ─── 4. Mediações e Conflitos (Sigilo Estrito) ───
    match /mediacoes/{mediacaoId} {
      allow read, write: if isAuthenticated();
    }

    // ─── 5. Notificações do Sistema ───
    match /notificacoes/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ─── 6. Candidatos a Vagas (Formulário Público) ───
    match /candidatos/{docId} {
      allow create: if request.resource.data.keys().hasAll(['nome', 'email']) &&
                       request.resource.data.nome is string &&
                       request.resource.data.email is string &&
                       request.resource.data.nome.size() >= 2 &&
                       request.resource.data.nome.size() <= 120;
      allow read, update, delete: if isAuthenticated();
    }

    // ─── 7. Moradores, Pets e Veículos ───
    match /moradores/{moradorId} {
      allow read, write: if isAuthenticated();
    }

    match /pets/{petId} {
      allow read, write: if isAuthenticated();
    }

    match /veiculos/{veiculoId} {
      allow read, write: if isAuthenticated();
    }

    // ─── 8. Auditoria (Write-Once / Read-Only) ───
    match /auditoria_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    match /auditoria/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── 9. Ponto Eletrônico ───
    match /ponto_registros/{pontoId} {
      allow read, write: if isAuthenticated();
    }

    // ─── 10. Enquetes e Votações (Suporta Votação Pública Isolada) ───
    match /enquetes/{enqueteId} {
      allow read: if hasAnyAuth();
      allow update: if hasAnyAuth();
      allow create, delete: if isAuthenticated();
    }

    // ─── 11. Tarefas e Manutenções (Suporta Baixa Rápida Isolada) ───
    match /tarefas/{id} {
      allow read: if hasAnyAuth();
      allow update: if hasAnyAuth();
      allow create, delete: if isAuthenticated();
    }

    match /manutencoes/{id} {
      allow read: if hasAnyAuth();
      allow update: if hasAnyAuth();
      allow create, delete: if isAuthenticated();
    }

    // ─── 12. Blog Institucional ───
    match /blog_posts/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─── 13. Leads de Diagnóstico (Site Oficial) ───
    match /leads_diagnosticos/{docId} {
      allow create: if request.resource.data.keys().hasAll(['nome', 'whatsapp', 'condominio']) &&
                       request.resource.data.nome is string &&
                       request.resource.data.whatsapp is string &&
                       request.resource.data.nome.size() >= 2 &&
                       request.resource.data.nome.size() <= 120;
      allow read, update, delete: if isAuthenticated();
    }

    match /site_stats/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if true;
    }

    // ─── 14. Módulos Operacionais e Financeiros do ERP ───
    match /condominios/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /financeiro_lancamentos/{id} {
      allow read, write: if isAuthenticated();
    }

    match /boletos/{id} {
      allow read, write: if isAuthenticated();
    }

    match /cotacoes/{id} {
      allow read, write: if isAuthenticated();
    }

    match /apolices/{id} {
      allow read, write: if isAuthenticated();
    }

    match /notas_fiscais/{id} {
      allow read, write: if isAuthenticated();
    }

    match /documentos/{id} {
      allow read, write: if isAuthenticated();
    }

    match /cameras/{id} {
      allow read, write: if isAuthenticated();
    }

    match /comunicados/{id} {
      allow read, write: if isAuthenticated();
    }

    match /avisos/{id} {
      allow read, write: if isAuthenticated();
    }

    match /reservas/{id} {
      allow read, write: if isAuthenticated();
    }

    match /ocorrencias/{id} {
      allow read, write: if isAuthenticated();
    }

    match /assembleias/{id} {
      allow read, write: if isAuthenticated();
    }

    match /encomendas/{id} {
      allow read, write: if isAuthenticated();
    }

    match /portaria/{id} {
      allow read, write: if isAuthenticated();
    }

    // ─── 15. Regra Padrão Defensiva: Default Deny Absoluto ───
    // Bloqueia qualquer coleção não expressamente autorizada acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
