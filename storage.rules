rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Regra global padrão: bloqueia acesso por padrão
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.resource.size <= 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Pasta pública para recebimento controlado de currículos e onboarding de candidatos
    match /candidatos/{allPaths=**} {
      allow create: if request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow read, update, delete: if request.auth != null;
    }

    match /onboarding/{allPaths=**} {
      allow create: if request.resource.size <= 15 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow read, update, delete: if request.auth != null;
    }

    // Comprovantes de ponto eletrônico (fotos batimento com geolocalização)
    match /ponto/{allPaths=**} {
      allow create: if request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read, update, delete: if request.auth != null;
    }
  }
}
