rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Backups completos do sistema no cofre da nuvem (JSON comprimido até 100MB)
    match /backups_sistema/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Regra global padrão
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
        && request.resource.size <= 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') 
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/json'
            || request.resource.contentType == 'application/octet-stream');
    }

    // Pasta pública para recebimento controlado de currículos e onboarding de candidatos
    match /candidatos/{allPaths=**} {
      allow create: if request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow read, update, delete: if request.auth != null;
    }

    match /onboarding/{allPaths=**} {
      allow create: if request.resource.size <= 15 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow read, update, delete: if request.auth != null;
    }

    // Comprovantes de ponto eletrônico (fotos batimento com geolocalização)
    match /ponto/{allPaths=**} {
      allow create: if request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read, update, delete: if request.auth != null;
    }
  }
}
